{"cve_id": "CVE-2024-4344", "published_date": "2024-06-02T05:15:47.620", "last_modified_date": "2024-11-21T09:42:40.023", "description": "The Shield Security – Smart Bot Blocking & Intrusion Prevention Security plugin for WordPress is vulnerable to Cross-Site Request Forgery in all versions up to, and including, 19.1.13. This is due to missing or incorrect nonce validation on the exec function. This makes it possible for unauthenticated attackers to disable pin protection for the admin interface of the plugin via a forged request granted they can trick a site administrator into performing an action such as clicking on a link.", "cwe_ids": [], "nvd_cvss_v31_vector": "", "nvd_cvss_v31_score": null, "nvd_cvss_v31_severity": "", "cna_cvss_v31_vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:U/C:N/I:L/A:N", "cna_cvss_v31_score": 4.3, "cna_cvss_v31_severity": "MEDIUM", "nvd_cvss_v4_vector": "", "nvd_cvss_v4_score": null, "nvd_cvss_v4_severity": "", "cna_cvss_v4_vector": "", "cna_cvss_v4_score": null, "cna_cvss_v4_severity": ""}
